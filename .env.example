# Database
DATABASE_URL=postgresql://devcreator:devcreator@localhost:5432/devcreator

# App URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Inngest
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Google Gemini — PRIMARY: chat, ideas, content creation, analysis, vision
# Free tier: 1,500 req/day on Flash, 50 req/day on Pro
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — FAST: classification, extraction, batch tagging
# Free tier: generous rate limits on Llama 3.x models
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — EXPERIMENTAL: free model playground / fallback only
# Not on the critical path — used for trying new free models
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Embeddings (Phase 2) ──────────────────────────────────────────────────
# Phase 1 uses PostgreSQL full-text search (no embedding cost).
# Add a cloud embedding provider here when semantic retrieval is needed.
# OPENAI_API_KEY=

# ─── Platform OAuth ────────────────────────────────────────────────────────────
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram (Meta App)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube (Google OAuth — same Google project as Gemini is fine)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
